APP_ENV=development
APP_DEBUG=true

DB_DRIVER=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=imc_uam
DB_USER=postgres
DB_PASS=

# Must be at least 32 characters. Generate one with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ISSUER=imc-uam
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Angular dev server origin (comma separated for several)
CORS_ORIGIN=http://localhost:4200

LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
